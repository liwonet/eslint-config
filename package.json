{
  "name": "@liwo/eslint-config",
  "type": "module",
  "version": "0.2.3",
  "packageManager": "pnpm@11.0.1",
  "description": "ESLint config by Liwo",
  "author": "Aoang <aoang@x2oe.com>",
  "license": "MIT",
  "homepage": "https://github.com/liwonet/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liwonet/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/liwonet/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run gen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build && tsx scripts/fixed-netlify.ts",
    "watch": "tsdown --watch",
    "lint": "eslint",
    "format": "eslint --fix .",
    "gen": "tsx scripts/typegen.ts",
    "prepack": "pnpm run build",
    "test": "vitest",
    "release": "bumpp --sign",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@unocss/eslint-plugin": "^66.6.6",
    "eslint": "^10.0.3",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "prettier-plugin-slidev": "^1.0.5"
  },
  "peerDependenciesMeta": {
    "@prettier/plugin-xml": {
      "optional": true
    },
    "@unocss/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "prettier-plugin-slidev": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "1.1.0",
    "@clack/prompts": "1.4.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint-react/eslint-plugin": "5.8.4",
    "@eslint/markdown": "8.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "@vitest/eslint-plugin": "1.6.16",
    "eslint-config-flat-gitignore": "2.3.0",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-merge-processors": "2.0.0",
    "eslint-plugin-antfu": "3.2.2",
    "eslint-plugin-command": "3.5.2",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-jsonc": "3.1.2",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-pnpm": "1.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-toml": "1.3.1",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.9.1",
    "eslint-plugin-yml": "3.3.2",
    "eslint-processor-vue-blocks": "2.0.0",
    "globals": "17.6.0",
    "jsonc-eslint-parser": "3.1.0",
    "local-pkg": "1.2.1",
    "parse-gitignore": "2.0.0",
    "toml-eslint-parser": "1.0.3",
    "vue-eslint-parser": "10.4.0",
    "yaml-eslint-parser": "2.0.0"
  },
  "devDependencies": {
    "@eslint/config-inspector": "2.0.0",
    "@liwo/eslint-config": "workspace:*",
    "@prettier/plugin-xml": "3.4.2",
    "@types/node": "25.6.2",
    "@unocss/eslint-plugin": "66.6.8",
    "bumpp": "11.1.0",
    "eslint": "10.3.0",
    "eslint-plugin-vuejs-accessibility": "2.5.0",
    "eslint-typegen": "2.3.1",
    "execa": "9.6.1",
    "lint-staged": "16.4.0",
    "pnpm-workspace-yaml": "1.6.0",
    "prettier-plugin-slidev": "1.0.5",
    "react": "19.2.5",
    "simple-git-hooks": "2.13.1",
    "tinyglobby": "0.2.16",
    "tsdown": "0.21.10",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5",
    "vue": "3.5.33"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
