{
  "name": "@liwo/eslint-config",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@10.26.2",
  "description": "ESLint config by Liwo",
  "author": "Aoang <aoang@x2oe.com>",
  "license": "MIT",
  "homepage": "https://github.com/liwonet/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liwonet/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/liwonet/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run gen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build && tsx scripts/fixed-netlify.ts",
    "watch": "tsdown --watch",
    "lint": "eslint",
    "format": "eslint --fix .",
    "gen": "tsx scripts/typegen.ts",
    "prepack": "pnpm run build",
    "test": "vitest",
    "release": "bumpp --sign",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@unocss/eslint-plugin": "^66.3.3",
    "eslint": "^9.38.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "prettier-plugin-slidev": "^1.0.5"
  },
  "peerDependenciesMeta": {
    "@prettier/plugin-xml": {
      "optional": true
    },
    "@unocss/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "prettier-plugin-slidev": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "1.1.0",
    "@clack/prompts": "0.11.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.5.0",
    "@eslint-react/eslint-plugin": "2.7.2",
    "@eslint/markdown": "7.5.1",
    "@stylistic/eslint-plugin": "5.6.1",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "@vitest/eslint-plugin": "1.6.4",
    "eslint-config-flat-gitignore": "2.1.0",
    "eslint-flat-config-utils": "2.1.4",
    "eslint-merge-processors": "2.0.0",
    "eslint-plugin-antfu": "3.1.1",
    "eslint-plugin-command": "3.4.0",
    "eslint-plugin-format": "1.1.0",
    "eslint-plugin-import-lite": "0.4.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-pnpm": "1.4.3",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-regexp": "2.10.0",
    "eslint-plugin-toml": "0.12.0",
    "eslint-plugin-unicorn": "62.0.0",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-plugin-vue": "10.6.2",
    "eslint-plugin-yml": "1.19.1",
    "eslint-processor-vue-blocks": "2.0.0",
    "globals": "17.0.0",
    "jsonc-eslint-parser": "2.4.2",
    "local-pkg": "1.1.2",
    "parse-gitignore": "2.0.0",
    "toml-eslint-parser": "0.10.1",
    "vue-eslint-parser": "10.2.0",
    "yaml-eslint-parser": "1.3.2"
  },
  "devDependencies": {
    "@eslint/config-inspector": "1.4.2",
    "@liwo/eslint-config": "workspace:*",
    "@prettier/plugin-xml": "3.4.2",
    "@types/node": "25.0.3",
    "@unocss/eslint-plugin": "66.6.0",
    "bumpp": "10.3.2",
    "eslint": "9.39.2",
    "eslint-plugin-vuejs-accessibility": "2.4.1",
    "eslint-typegen": "2.3.0",
    "execa": "9.6.1",
    "lint-staged": "16.2.7",
    "pnpm-workspace-yaml": "1.4.3",
    "prettier-plugin-slidev": "1.0.5",
    "react": "19.2.3",
    "simple-git-hooks": "2.13.1",
    "tinyglobby": "0.2.15",
    "tsdown": "0.18.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16",
    "vue": "3.5.26"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "volta": {
    "node": "22.17.1"
  }
}
